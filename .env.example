# Client ID Spotify. Public par nature en PKCE, le préfixe VITE_ est légitime.
VITE_SPOTIFY_CLIENT_ID=

# En local : http://127.0.0.1:5173/callback  (JAMAIS localhost, Spotify le refuse)
# En production : https://ton-site.netlify.app/callback
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# JAMAIS de préfixe VITE_ ici. Cette clé ne quitte pas la Netlify Function.
# À déclarer dans l'interface Netlify, pas dans un fichier versionné.
ANTHROPIC_API_KEY=

# Sel du condensé d'adresse IP pour la limitation de débit. Netlify uniquement.
SEL_DEBIT=

# Plafond global d'appels par jour, tous appelants confondus. Défaut : 300.
# C'est ce plafond qui borne réellement la facture Anthropic.
PLAFOND_GLOBAL_QUOTIDIEN=300
